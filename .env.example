# ==============================================================================
# CaseGuard — Master Environment Reference
# Copy this file or set appropriate values in backend/.env, frontend/.env.local, etc.
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIMARY BACKEND (backend/.env)
# ------------------------------------------------------------------------------

# Node environment & port
NODE_ENV=development
PORT=5000

# MongoDB Connection (Local or Atlas)
# Format: mongodb://localhost:27017/caseguard OR mongodb+srv://<user>:<pass>@cluster.mongodb.net/caseguard
MONGO_URI=mongodb://localhost:27017/caseguard

# JWT secret key for signing auth tokens (minimum 32 random characters in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# High-Speed LLM Inference (Groq: gpt-oss-120b & whisper-large-v3 transcription)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (gpt-4o-mini clinical fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Credentials (AWS Comprehend PII entity detection & KMS)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# Microservices Network Routing
PII_SERVICE_URL=http://localhost:5001
KNOWLEDGE_SERVICE_URL=http://localhost:5002
SCREENER_SERVICE_URL=http://localhost:5003
PATTERN_SERVICE_URL=http://localhost:5004
RISK_SERVICE_URL=http://localhost:5005

# Feature Flags
USE_MOCK_ML=false

# ------------------------------------------------------------------------------
# FRONTEND (frontend/.env.local)
# ------------------------------------------------------------------------------

# Next.js API endpoint pointing to the backend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
